# The only required deployment value. In Dokploy, set this in Environment.
BUZZ_DOMAIN=buzz.example.com

# Images published by .github/workflows/buzz-web-image.yml.
BUZZ_IMAGE=ghcr.io/physikal/buzz-web:main
BUZZ_AGENT_IMAGE=ghcr.io/physikal/buzz-web:agent-main

# Optional process limit for the centralized host.
BUZZ_AGENT_HOST_MAX_AGENTS=8
